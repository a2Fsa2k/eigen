# Copy this to .env and fill in your values

# ── AI toggle ────────────────────────────────────────────────────────────────
# Set to true when you're ready to connect a real LLM.
# When false, /query returns a mock response with the full prompt dry-run.
AI_ENABLED=false

# ── LLM provider ─────────────────────────────────────────────────────────────
# Supported: "openai" (OpenAI-compatible) | "gemini" (native)
LLM_PROVIDER=openai

# ── Gemini (native) ──────────────────────────────────────────────────────────
# Only used when LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# ── OpenAI-compatible backend ────────────────────────────────────────────────
# Defaults to local ollama. Swap for OpenAI / LM Studio as needed.
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=llama3.2

# Set to your real key if using OpenAI instead of ollama
OPENAI_API_KEY=ollama

# ── Server ───────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
